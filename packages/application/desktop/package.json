{
  "name": "@tooth/desktop",
  "version": "0.1.0",
  "private": true,
  "author": "Tooth",
  "description": "Tooth CBCT desktop shell (Electron)",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.12",
    "@types/node": "^22.13.10",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "^35.7.5",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "tailwindcss": "4.1.12",
    "tree-kill": "^1.2.2",
    "typescript": "^6.0.2",
    "vite": "^6.4.2"
  },
  "build": {
    "appId": "com.tooth.cbct",
    "productName": "Tooth",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../frontend/dist",
        "to": "application/frontend/dist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../backend",
        "to": "application/backend"
      },
      {
        "from": "../../../packages/models",
        "to": "models",
        "filter": [
          "*.onnx"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.medical",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
